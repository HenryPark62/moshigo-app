+++ b/foodguide/image_jobs.py
@@ -0,0 +1,92 @@
+"""Owner-scoped, idempotent food illustration jobs on a separate worker."""
+from __future__ import annotations
+
+import base64
+import hashlib
+import io
+import json
+import os
+import re
+import warnings
+
+from PIL import Image
+
+from .api_models import FoodImageDish, FoodImageResult
+from .models import FoodProfile
+from .openai_client import GuideAPIError
+
+
+DEFAULT_IMAGE_MODEL = 'gpt-image-2-2026-04-21'
+PROMPT_VERSION = 'foodguide-stage3-v1'
+MAX_PNG_BYTES = 4 * 1024 * 1024
+IMAGE_TTL = 7 * 24 * 60 * 60
+MAX_PENDING = 16
+SAFE_FAILURES = {
+    'daily_budget_exceeded': '오늘의 이미지 생성 서비스 호출 한도에 도달했습니다.',
+    'budget_unavailable': '이미지 생성 서비스 사용량 설정을 확인할 수 없습니다.',
+    'image_generation_failed': '음식 이미지를 생성하지 못했습니다. 같은 작업은 자동으로 다시 생성하지 않습니다.',
+}
+
+
+def configured_model():
+    model = os.environ.get('FOODGUIDE_IMAGE_MODEL', DEFAULT_IMAGE_MODEL).strip()
+    if not re.fullmatch(r'[A-Za-z0-9._:/-]{1,100}', model):
+        raise ValueError('FOODGUIDE_IMAGE_MODEL must be a valid model identifier')
+    return model
+
+
+def canonical_descriptor(dish):
+    return FoodImageDish.model_validate(dish).model_dump()
+
+
+def _canonical_json(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'))
+
+
+def descriptor_hash(dish):
+    return hashlib.sha256(_canonical_json(canonical_descriptor(dish)).encode()).hexdigest()
+
+
+def image_job_id(owner, dish, model):
+    value = [owner, canonical_descriptor(dish), model, PROMPT_VERSION]
+    return hashlib.sha256(_canonical_json(value).encode()).hexdigest()[:32]
+
+
+def validate_png(data):
+    if not isinstance(data, bytes) or not 0 < len(data) <= MAX_PNG_BYTES or not data.startswith(b'\x89PNG\r\n\x1a\n'):
+        raise ValueError('Invalid PNG result')
+    with warnings.catch_warnings():
+        warnings.simplefilter('error', Image.DecompressionBombWarning)
+        with Image.open(io.BytesIO(data)) as image:
+            if image.format != 'PNG' or image.width * image.height > 20_000_000:
+                raise ValueError('Invalid image dimensions')
+            image.verify()
+    return data
+
+
+class ImageProcessor:
+    """The generator is injectable for offline tests; real calls retain budget guards."""
+    def __init__(self, generator=None):
+        self.generator = generator
+
+    def __call__(self, payload):
+        try:
+            dish = canonical_descriptor(payload['dish'])
+            model = payload['model']
+            digest = descriptor_hash(dish)
+            if payload.get('descriptor_hash') != digest or payload.get('prompt_version') != PROMPT_VERSION:
+                raise ValueError('Image payload identity mismatch')
+            if not isinstance(model, str) or not re.fullmatch(r'[A-Za-z0-9._:/-]{1,100}', model):
+                raise ValueError('Invalid image model')
+            profile = FoodProfile(name=dish['name'], original_name=dish['original_name'],
+                                  main_ingredients=dish['ingredients'], cooking_methods=dish['cooking_methods'])
+            generator = self.generator
+            if generator is None:
+                from .stage3 import generate_food_image
+                generator = generate_food_image
+            data = validate_png(generator(profile, model=model))
+            return FoodImageResult(descriptor_hash=digest, image_base64=base64.b64encode(data).decode('ascii'),
+                                   sha256=hashlib.sha256(data).hexdigest(), model=model).model_dump()
+        except Exception as error:
+            code = error.code if isinstance(error, GuideAPIError) and error.code in SAFE_FAILURES else 'image_generation_failed'
+            raise GuideAPIError(SAFE_FAILURES[code], code=code) from None
