+"""Food-image jobs use only fake generators; never call a live image provider."""
+import base64
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import io
+import json
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from fastapi.testclient import TestClient
+from PIL import Image
+import pytest
+
+from foodguide.api import create_app
+from foodguide.api_models import FoodImagesRequest
+from foodguide.image_jobs import (DEFAULT_IMAGE_MODEL, PROMPT_VERSION, MAX_PNG_BYTES, IMAGE_TTL,
+                                 ImageProcessor, canonical_descriptor, descriptor_hash, image_job_id)
+from foodguide.jobs import JobStore, QueueFull, JobIDConflict
+from foodguide.openai_client import GuideAPIError
+
+
+KEY = 'image-test-key-' + 'a' * 32
+OTHER = 'image-test-key-' + 'b' * 32
+HEADERS = {'X-API-Key': KEY}
+DISH = {'name': '슈니첼', 'original_name': 'Schnitzel', 'ingredients': ['돼지고기', '빵가루'], 'cooking_methods': ['튀기기']}
+
+
+class Analysis:
+    def analyze_text(self, payload):
+        return {'items': [{'input_name': name, 'status': 'ok'} for name in payload['menus']]}
+
+
+def png():
+    out = io.BytesIO()
+    Image.new('RGB', (12, 12), 'orange').save(out, 'PNG')
+    return out.getvalue()
+
+
+@pytest.fixture(autouse=True)
+def fixed_environment(monkeypatch):
+    monkeypatch.setenv('FOODGUIDE_IMAGE_MODEL', DEFAULT_IMAGE_MODEL)
+    monkeypatch.setenv('FOODGUIDE_API_REQUESTS_PER_MINUTE', '100')
+
+
+def app_at(tmp_path, generator=None, keys=None):
+    return create_app(Analysis(), tmp_path / 'jobs.sqlite3', keys or [KEY],
+                      image_generator=generator or (lambda profile, *, model: png()))
+
+
+def submit(client, dishes=None, headers=None):
+    return client.post('/v1/food-images', headers=headers or HEADERS, json={'dishes': dishes or [DISH]})
+
+
+def wait_for(client, image_id, headers=None):
+    deadline = time.monotonic() + 4
+    while time.monotonic() < deadline:
+        response = client.get('/v1/food-images/' + image_id, headers=headers or HEADERS)
+        assert response.status_code == 200
+        body = response.json()
+        if body['status'] in ('completed', 'failed'):
+            return body
