+def test_image_worker_does_not_block_analysis_and_running_post_deduplicates(tmp_path):
+    started, release = threading.Event(), threading.Event()
+    calls = []
+    def generate(profile, *, model):
+        calls.append(1)
+        started.set()
+        assert release.wait(timeout=4)
+        return png()
+    with TestClient(app_at(tmp_path, generate)) as client:
+        try:
+            image_id = submit(client).json()['images'][0]['image_id']
+            assert started.wait(timeout=2)
+            row = submit(client).json()['images'][0]
+            assert row['image_id'] == image_id and row['status'] == 'running'
+            analysis_id = client.post('/v1/jobs/text', headers=HEADERS, json={'menus': ['국']}).json()['job_id']
+            deadline = time.monotonic() + 2
+            while time.monotonic() < deadline:
+                analysis = client.get('/v1/jobs/' + analysis_id, headers=HEADERS).json()
+                if analysis['status'] == 'completed':
+                    break
+                time.sleep(.01)
+            assert analysis['status'] == 'completed' and not release.is_set()
+        finally:
+            release.set()
+        assert wait_for(client, image_id)['status'] == 'completed' and len(calls) == 1
