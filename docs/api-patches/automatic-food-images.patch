+def test_retry_token_survives_finish_and_cap_owner_checks_are_atomic(tmp_path):
+    store = JobStore(tmp_path / 'retry.sqlite3', max_pending=1)
+    job_id, blocker = 'a' * 32, 'b' * 32
+    store.enqueue('owner', 'food-image', {}, job_id=job_id)
+    store.finish(job_id, error={'code': 'failed', 'message': 'failed'})
+    store.enqueue('owner', 'food-image', {}, job_id=blocker)
+    with pytest.raises(JobIDConflict):
+        store.enqueue('other', 'food-image', {}, job_id=job_id, retry_token='c' * 32)
+    with pytest.raises(QueueFull):
+        store.enqueue('owner', 'food-image', {}, job_id=job_id, retry_token='c' * 32)
+    assert store.get(job_id, 'owner')['status'] == 'failed'
+    store.finish(blocker, result={})
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        ids = list(pool.map(lambda _: store.enqueue('owner', 'food-image', {}, job_id=job_id, retry_token='c' * 32), range(8)))
+    assert ids == [job_id] * 8
+    assert store.get(job_id, 'owner')['status'] == 'queued'
+    store.finish(job_id, error={'code': 'failed', 'message': 'failed'})
+    with store.connect() as db:
+        row = db.execute('SELECT payload,retry_token FROM jobs WHERE id=?', (job_id,)).fetchone()
+        assert row['payload'] is None and row['retry_token'] == 'c' * 32
+    assert store.enqueue('owner', 'food-image', {}, job_id=job_id, retry_token='c' * 32) == job_id
+    assert store.get(job_id, 'owner')['status'] == 'failed'
